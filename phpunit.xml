        <env name="APP_KEY" value="base64:4k8wH40H4sL3q89X77K2sP3b772X556X00x12345678="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
