          "name": "List Public Fatawa",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/fatawa?search=রোজা&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["fatawa"]
            }
          }
        },
        {
          "name": "Ask Fatwa Question",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question_title\": \"মুসাফিরের জন্য সালাত কসরের বিধান কী?\",\n  \"question_body\": \"আমি ঢাকা থেকে সিলেট ভ্রমণ করার সময় ৪ রাকাত ফরজ নামাজ কীভাবে আদায় করব?\",\n  \"is_private\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/fatawa/ask",
              "host": ["{{base_url}}"],
              "path": ["fatawa", "ask"]
            }
          }
        }
      ]
