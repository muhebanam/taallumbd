APP_NAME="আত-তাআল্লুম | TaallumBD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=bn_BD

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=taallumbd_dev
DB_USERNAME=postgres
DB_PASSWORD=devsecretpassword

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Cloudflare R2 Cloud Storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BUCKET=taallum-public
R2_PRIVATE_BUCKET=taallum-private
R2_PUBLIC_URL=
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@taallumbd.com"
MAIL_FROM_NAME="${APP_NAME}"

# Automated Payment Gateways (Default: Disabled, Mode: sandbox)
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

BKASH_ENABLED=false
BKASH_MODE=sandbox
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Manual Payment Configuration
PAYMENT_DEFAULT_GATEWAY=manual
PAYMENTS_MOCK_ENABLED=false
BKASH_MANUAL_NUMBER=01700000000
BKASH_MANUAL_TYPE=personal
NAGAD_MANUAL_NUMBER=01700000000
NAGAD_MANUAL_TYPE=personal
ROCKET_MANUAL_NUMBER=01700000000
ROCKET_MANUAL_TYPE=personal
CRON_SECRET=

VITE_APP_NAME="${APP_NAME}"

